# -----------------------------------------------------------------------------
# Risk Management Parameters
# -----------------------------------------------------------------------------
MAX_CAPITAL_PER_TRADE=10000          # Max ₹ per single trade
MAX_DAILY_LOSS=5000                  # Halt bot if daily loss exceeds this (₹)
MAX_OPEN_POSITIONS=3                 # Maximum concurrent positions
TRAILING_STOP_LOSS_PCT=0.5           # Trailing SL as % of price (0.5 = 0.5%)
GEMINI_ANALYSIS_INTERVAL=300         # Seconds between Gemini scans (default: 5 min)

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
