# =============================================================================
# AlgoTrader configuration. Copy to .env and fill in. NEVER commit .env.
# Every key can also be supplied as a real environment variable (these win).
# =============================================================================

# ── Mode (both switches are required for live trading) ───────────────────────
PAPER_TRADING=true
LIVE_TRADING_ACKNOWLEDGED=false

# ── API security ─────────────────────────────────────────────────────────────
# Required. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
API_AUTH_TOKEN=
HOST=127.0.0.1
PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── Angel One SmartAPI (needed for market data in paper mode too) ────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Strategy: gemini | ema_crossover ─────────────────────────────────────────
STRATEGY=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
CANDLE_INTERVAL=FIFTEEN_MINUTE
CANDLE_LOOKBACK_DAYS=5
# Seconds between signal cycles (historical name kept for compatibility).
GEMINI_ANALYSIS_INTERVAL=300

# ── Risk limits (₹) ──────────────────────────────────────────────────────────
MAX_CAPITAL_PER_TRADE=10000
MAX_RISK_PER_TRADE=500
MAX_DAILY_LOSS=5000
MAX_OPEN_POSITIONS=3
TRAILING_STOP_LOSS_PCT=0.5
MIN_CONFIDENCE=0.55
MIN_REWARD_RISK=1.5
MAX_ENTRY_DEVIATION_PCT=1.0
ALLOW_SHORT=true
MAX_ORDERS_PER_MINUTE=10
MAX_CONSECUTIVE_EXIT_FAILURES=3
STALE_PRICE_SECONDS=15
RISK_CHECK_INTERVAL_SECONDS=1

# ── Execution cost model (paper + backtest; also used as a live PnL estimate)
SLIPPAGE_BPS=2
FEE_PER_ORDER=20
ORDER_FILL_TIMEOUT_SECONDS=15

# ── Session (IST, HH:MM) ─────────────────────────────────────────────────────
MARKET_OPEN=09:15
ENTRY_CUTOFF=14:55
SQUARE_OFF_TIME=15:10
MARKET_CLOSE=15:30
HOLIDAYS_FILE=config/nse_holidays.json

# ── Storage / logging ────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/algotrader.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/algotrader  (pip install asyncpg)
WATCHLIST_FILE=config/watchlist.json
LOG_DIR=logs
LOG_LEVEL=INFO
LOG_FORMAT=console
